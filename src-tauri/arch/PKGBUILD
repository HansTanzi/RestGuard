# Maintainer: HansTanzi <https://github.com/HansTanzi>

# Used by scripts/arch-package.sh: repackages the .deb built by Tauri as an Arch .pkg.tar.zst.
# The script fills in pkgver and puts restguard.deb and both licenses in the same directory
pkgname=restguard
pkgver=0.0.0
pkgrel=1
pkgdesc="Cross-platform break reminder that actually makes you rest"
arch=('x86_64')
url="https://github.com/HansTanzi/RestGuard"
license=('MIT OR Apache-2.0')
# openssl: ureq uses the system TLS stack for ntfy phone notifications
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'openssl')
# The binary is already stripped by cargo, so no further strip is needed and there are no debug symbols to split
options=('!debug' '!strip')
source=('restguard.deb' 'LICENSE-MIT' 'LICENSE-APACHE')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
