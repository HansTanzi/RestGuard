<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store (MSIX) package manifest, packaged by scripts/msix.ps1; the script fills in Version from tauri.conf.json.
  Name, Publisher and PublisherDisplayName in Identity must exactly match the values on the
  Product identity page in Partner Center, otherwise the upload is rejected.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop rescap">

  <Identity
    Name="HansTanzi.RestGuard"
    Publisher="CN=B1B7C6E2-AD18-42F3-A50F-89B582EFD909"
    Version="$VERSION$"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>RestGuard</DisplayName>
    <PublisherDisplayName>HansTanzi</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="zh-CN" />
  </Resources>

  <Applications>
    <Application Id="RestGuard" Executable="restguard.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="RestGuard"
        Description="Break reminder that actually makes you rest"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Autostart: TaskId matches STARTUP_TASK_ID in src-tauri/src/msix.rs -->
        <uap5:Extension Category="windows.startupTask" Executable="restguard.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="RestGuardStartup" Enabled="false" DisplayName="RestGuard" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
